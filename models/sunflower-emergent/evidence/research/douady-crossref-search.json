              "journal-title": "Amer. J. Bot."
            },
            {
              "key": "36_CR33",
              "doi-asserted-by": "publisher",
              "first-page": "981",
              "DOI": "10.2307/2442253",
              "volume": "64",
              "author": "RO Erickson",
