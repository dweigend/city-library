            },
            {
              "key": "36_CR20",
              "unstructured": "The exact geometry should not be an important parameter, provided it has axisymmetry. In botany, similar phyllotactic modes are obtained with various apical meristem profiles."
            },
            {
              "key": "36_CR21",
              "doi-asserted-by": "crossref",
              "unstructured": "Massart R.(1981) I.E.E.E. Trans. Magn. 17,1247.",
              "DOI": "10.1109/TMAG.1981.1061188"
            },
            {
              "key": "36_CR22",
              "doi-asserted-by": "publisher",
              "first-page": "509",
              "DOI": "10.1098/rstb.1951.0007",
              "volume": "225",
