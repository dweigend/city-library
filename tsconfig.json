{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": [
      "bun",
      "svelte",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "city-library": [
        "./index.ts"
      ],
      "$lib": [
        "./ui"
      ],
      "$lib/*": [
        "./ui/*"
      ],
      "$ui": [
        "./ui"
      ],
      "$ui/*": [
        "./ui/*"
      ]
    }
  },
  "include": [
    "index.ts",
    "library/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.svelte",
    "models/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "model-lab-output",
    "tests/targets/**/*.ts"
  ]
}
