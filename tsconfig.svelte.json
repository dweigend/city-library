{
  "extends": "./tsconfig.ui.json",
  "compilerOptions": {
    "types": ["svelte", "vite/client"],
    "paths": {
      "city-library": ["./index.ts"],
      "$lib": ["./ui"],
      "$lib/*": ["./ui/*"],
      "$ui": ["./ui"],
      "$ui/*": ["./ui/*"]
    }
  },
  "include": ["ui/**/*.ts", "ui/**/*.svelte", "experiments/**/*.ts"],
  "exclude": ["node_modules", "agent-lab-output"]
}
