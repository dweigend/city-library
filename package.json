{
  "name": "city-library",
  "version": "0.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "dist"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.70.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/bun": "1.4.4",
    "bits-ui": "2.20.6",
    "clsx": "2.1.1",
    "cytoscape": "3.34.4",
    "svelte": "5.57.3",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "scripts": {
    "typecheck": "bun run check:ui:svelte",
    "test": "bun test tests models",
    "build": "bun build index.ts --target browser --format esm --outdir dist && bun scripts/typescript.ts declarations",
    "consumer": "bun tests/package-consumer.ts",
    "check": "bun run typecheck && bun run test && bun run check:migration && bun run contracts && bun run build && bun run consumer",
    "check:ui:svelte": "bun run --cwd ui/agent-lab check",
    "typecheck:quad-layouts": "bun run typecheck",
    "typecheck:city": "bun run typecheck",
    "typecheck:city:targets": "bun scripts/typescript.ts city-targets",
    "typecheck:targets": "bun scripts/typescript.ts targets",
    "typecheck:giant-component:targets": "bun scripts/typescript.ts giant-component-targets",
    "dev": "bun --bun run vite --config vite.config.ts",
    "build:ui": "bun --bun run vite build --config vite.config.ts",
    "preview": "bun --bun run vite preview --config vite.config.ts",
    "contracts": "bun scripts/public-contracts.ts",
    "contracts:quad-layouts": "bun scripts/public-contracts.ts --quad-layouts",
    "contracts:city": "bun scripts/public-contracts.ts --city",
    "contracts:city:targets": "bun scripts/public-contracts.ts --city --targets",
    "contracts:targets": "bun scripts/public-contracts.ts --targets",
    "check:migration": "bun scripts/check-examples-migration.ts"
  },
  "workspaces": [
    "ui/agent-lab"
  ]
}
