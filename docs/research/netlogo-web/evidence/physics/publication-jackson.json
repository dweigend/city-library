        {
          "key": "e_1_2_10_3_2_1",
          "unstructured": "Electromagnetism is part and parcel of almost everything that exists or happens. Its applications are everywhere. Recommendations for further reading can only touch on a few areas or subjects largely reflecting the writer's knowledge and prejudices."
        },
        {
          "key": "e_1_2_10_3_3_1",
          "unstructured": "For more leisurely or elementary accounts of electricity and magnetism consult the physics books"
        },
        {
          "key": "e_1_2_10_3_4_1",
          "volume-title": "Introduction to Classical Electrodynamics",
          "author": "Griffths D. J.",
          "year": "1989"
        },
        {
          "key": "e_1_2_10_3_5_1",
          "volume-title": "Electricity and Magnetism",
          "author": "Purcell E. M.",
          "year": "1985"
        },
        {
          "key": "e_1_2_10_3_6_1",
          "unstructured": "For a more applied but still elementary account see"
        },
        {
          "key": "e_1_2_10_3_7_1",
          "volume-title": "Electromagnetics",
          "author": "Kraus J. D.",
          "year": "1984"
        },
        {
          "key": "e_1_2_10_3_8_1",
          "unstructured": "For applications in engineering particularly transmission and radiation see"
        },
        {
